# ==============================================================================
# AIR ATLAS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or configure in Cloudflare dashboard.
# NEVER commit real API keys or sensitive secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Worker API (Production Secrets & Vars)
# ------------------------------------------------------------------------------
# Set via: wrangler secret put <NAME>  (or configure in .dev.vars for local worker)

# OpenWeatherMap API Key (Required for live weather, AQI, and map tile proxy)
# Free key available at: https://openweathermap.org/api
# Fallback: When omitted, Air Atlas automatically serves open data via Open-Meteo.
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# MapTiler API Key (Optional server-side key for geocoding)
# Free key available at: https://www.maptiler.com/
# Fallback: When omitted, Air Atlas automatically searches via Open-Meteo Geocoding.
MAPTILER_API_KEY=your_maptiler_api_key_here

# CORS Origin for Worker API (Leave as * or specify your Pages domain)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Frontend (Cloudflare Pages / Vite)
# ------------------------------------------------------------------------------
# Set in Cloudflare Pages Dashboard under Settings -> Environment Variables

# URL of deployed Cloudflare Worker API
# In local development: leave empty to use Vite proxy (/api)
# In production Pages: https://air-atlas-api.<your-subdomain>.workers.dev
VITE_API_BASE_URL=

# MapTiler Key for client-side MapLibre GL vector basemap
# Fallback: When omitted, Air Atlas automatically renders CARTO Dark Matter raster tiles.
VITE_MAPTILER_API_KEY=your_maptiler_client_key_here

# Optional: External Grafana Dashboard Embed URL
# Defaults to http://localhost:4000 when unconfigured
VITE_GRAFANA_URL=

# ------------------------------------------------------------------------------
# 3. Optional Local Express Server & Infrastructure (Docker Dev)
# ------------------------------------------------------------------------------
PORT=5000
REDIS_URL=redis://localhost:6379
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=climate-tracker
INFLUXDB_BUCKET=climate
WS_BROADCAST_INTERVAL=30000
